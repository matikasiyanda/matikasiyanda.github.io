<mxfile host="app.diagrams.net"><diagram name="agent-and-tools"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a" value="the agent&#10;Qwen3-1.7B + LoRA&#10;&#10;sees only the question&#10;and observations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="200" height="140" as="geometry"/></mxCell><mxCell id="s" value="search(queries: list, mode, k)&#10;&#10;list of query strings&#10;→ ~200-char excerpts + ids&#10;cheap — a LIST is the fan-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="320" height="110" as="geometry"/></mxCell><mxCell id="r" value="read(doc_ids: list)&#10;&#10;ids seen in search results&#10;→ full chunk text&#10;costs a turn + budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="190" width="320" height="100" as="geometry"/></mxCell><mxCell id="p" value="report(doc_ids: list)&#10;&#10;ordered, best first&#10;[] = not in the corpus&#10;ENDS the episode → reward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="320" height="110" as="geometry"/></mxCell><mxCell id="ret" value="retrieval&#10;BM25 (lexical)&#10;ColBERT (semantic, CPU)&#10;hybrid = RRF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="cor" value="corpus&#10;3785 chunks&#10;